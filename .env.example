# Public Formspree form ID for Velqora Agency's contact form.
# Copy this file to .env.local for local development and replace the placeholder
# with your real Formspree form ID (for example: NEXT_PUBLIC_FORMSPREE_FORM_ID=xabcd123).
# Note: NEXT_PUBLIC_FORMSPREE_FORM_ID is a public endpoint identifier (not a secret).
# NEVER commit .env.local to GitHub.

NEXT_PUBLIC_FORMSPREE_FORM_ID=your-formspree-form-id
